{
  "name": "jprime-companion",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "data:refresh": "node scripts/import-jprime-data.mjs",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend:up": "docker compose -f backend/docker-compose.yml up -d",
    "backend:down": "docker compose -f backend/docker-compose.yml down",
    "backend:run": "node scripts/run-gradle.mjs bootRun",
    "backend:test": "node scripts/run-gradle.mjs test"
  }
}
